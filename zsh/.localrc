###################################################################################
# Functions
###################################################################################
killport() {
	kill -9 $(lsof -ti:$@)
}

count(){
	ls $@ -1 | wc -l
}

gitExclude() {
	echo $@ >> ~/.git/info/exclude
}

###################################################################################
# TMUX
###################################################################################
# Fuzzy attach to or create a tmux session with Tab/Shift+Tab navigation
tn() {
    local name
    name=$(basename "$PWD" | tr '[:lower:]' '[:upper:]')
    tmux new-session -s "$name" $@
}

tk() {
	tmux kill-session -t $@
}

ta() {
	tmux attach-session -t $@
}

tl() {
	tmux ls
}

###################################################################################
# Git
###################################################################################
push(){
   git push --set-upstream origin $1
}

remote_checkout(){
  fetch
  git checkout -b $1 origin/$1
}

#####################################################################################
#Aliases
#####################################################################################
alias vim='nvim'
alias v='nvim'
alias mv='mv -i'
alias vlear='clear'
alias cls='clear'
alias clera='clear'
alias celar='clear'
alias ckear='clear'
alias ckear='clear'
alias ipconfig='ifconfig'
alias dot='cd ~/.dotfiles'
alias grep='rg'
if command -v fd &>/dev/null; then
  alias find='fd'
elif command -v fdfind &>/dev/null; then
  alias find='fdfind'
fi
if command -v eza &>/dev/null; then
  alias ls="eza"
  alias ll="eza -l --git"
  alias tree="eza --tree"
fi
alias lt='du -sh * | sort -h'
alias loads='cd ~/raft-tech'
alias src='source ~/.zshrc'
alias diff='nvim -d'
alias dif='command diff'
# Deprecated: use tmux prefix+s for session switching/deletion.
alias tms='~/.dotfiles/tmux/.config/tmux/tmux-sessionizer.sh'
alias tmw='~/.dotfiles/tmux/.config/tmux/tmux-worktree.sh'
alias tmwd='~/.dotfiles/tmux/.config/tmux/tmux-worktree-delete.sh'
alias pretty="jq '.'"

