###################################################################################
# Functions
###################################################################################
killport() {
	kill -9 $(lsof -ti:$@)
}

count(){
	ls $@ -1 | wc -l
}

gitExclude() {
	echo $@ >> ~/.git/info/exclude
}

###################################################################################
# TMUX
###################################################################################
# Fuzzy attach to or create a tmux session with Tab/Shift+Tab navigation
tn() {
    local name
    name=$(basename "$PWD" | tr '[:lower:]' '[:upper:]')
    tmux new-session -s "$name" $@
}

t() {
    if [ $# -gt 0 ]; then
        tmux new-session -A -s "$1"
    else
        sesh connect $(sesh list --tmux | fzf \
            --height 40% \
            --reverse \
            --border \
            --prompt '⚡ ' \
            --bind 'tab:down,shift-tab:up' \
            --bind 'ctrl-j:down,ctrl-k:up' \
            --pointer '▶' \
            --marker '✓' | tr -d '[:space:]')
    fi
}

# Set the terminal tab/window title before launching Codex.
codex() {
    local tab_title="codex"
    printf '\033]1;%s\007\033]2;%s\007' "$tab_title" "$tab_title"

    if [ -n "$TMUX" ]; then
        tmux set-window-option automatic-rename off >/dev/null 2>&1
        tmux rename-window "$tab_title" >/dev/null 2>&1
    fi

    command codex "$@"
}

###################################################################################
# Git
###################################################################################
push(){
   git push --set-upstream origin $1
}

remote_checkout(){
  fetch
  git checkout -b $1 origin/$1
}

