#####################################################################################
#Include Scripts to Path and Custom Functions
#####################################################################################
if [[ -d /opt/homebrew/opt/libpq/bin ]]; then
  export PATH="$PATH:/opt/homebrew/opt/libpq/bin"
fi

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

#####################################################################################
# Node Version Manager
#####################################################################################
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

#####################################################################################
# Go
#####################################################################################
export GOPATH="$HOME/go"
export PATH="$PATH:/usr/local/go/bin:$GOPATH/bin"
 export PATH="$(go env GOPATH)/bin:$PATH"

#####################################################################################
# FZF - Fuzzy Finder
#####################################################################################
# Shell keybindings: Ctrl+R (history), Ctrl+T (files), Alt+C (cd)
if command -v fzf &>/dev/null; then
    source <(fzf --zsh)
    export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
    if command -v fdfind &>/dev/null; then
        fd_cmd='fdfind'
    elif command -v fd &>/dev/null; then
        fd_cmd='fd'
    fi
    if [[ -n "$fd_cmd" ]]; then
        export FZF_DEFAULT_COMMAND="$fd_cmd --type f --hidden --follow --exclude .git"
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND="$fd_cmd --type d --hidden --follow --exclude .git"
    fi
fi

#####################################################################################
# Notes
#####################################################################################
note () {
  \nvim ~/notes/$(date '+%Y-%m-%d').md
}
alias notes='note'

#####################################################################################
# todo
#####################################################################################
todo () {
  \nvim ~/notes/todo.md
}
alias todos='todo'

# Terminal title
CUSTOM_TITLE=""

title() {
  CUSTOM_TITLE="$1"
  print -Pn "\e]0;$1\a"
}

# Add a blank line after ps1 and reset mouse tracking
# The printf disables mouse tracking modes that TUI apps may leave enabled
# Prevents garbage like "[<34;95;28M" when apps crash or don't clean up
precmd() {
  print ""
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l'
  if [[ -n "$CUSTOM_TITLE" ]]; then
    print -Pn "\e]0;$CUSTOM_TITLE\a"
  fi
}

softReset() {
  if [ -z "$1" ]; then
    echo "❌ Usage: squash_and_rebase <branch>"
    return 1
  fi

  local target_branch=$1

  # make sure we have the latest refs
  git fetch origin

  # find the common ancestor between current branch and target
  local base
  base=$(git merge-base HEAD origin/$target_branch) || return 1

  # squash all commits into one (keeps changes staged)
  git reset --soft "$base" || return 1
}


#####################################################################################
# Kubernetes
#####################################################################################
alias dbPortForward='kubectl port-forward svc/rdp-postgres 15432:5432 -n data-fabric --context kind-rdp > /dev/null 2>&1 &'

source ~/.raftrc

#####################################################################################
# Carapace - Shell Completion
#####################################################################################
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'

export CARAPACE_STYLE_CARAPACE_DESCRIPTION="dim"
export CARAPACE_STYLE_CARAPACE_VALUE="fg:#cba6f7"
export CARAPACE_STYLE_CARAPACE_KEYWORD="fg:#89b4fa,bold"
export CARAPACE_STYLE_CARAPACE_SECTION="fg:#a6e3a1,bold"
export CARAPACE_STYLE_CARAPACE_FLAG="fg:#f38ba8"

zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
if command -v carapace &>/dev/null; then
  source <(carapace _carapace)
fi
