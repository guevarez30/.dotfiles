#####################################################################################
# Notes
#####################################################################################
note () {
  \nvim ~/notes/$(date '+%Y-%m-%d').md
}
alias notes='note'

# Terminal title
CUSTOM_TITLE=""

title() {
  CUSTOM_TITLE="$1"
  print -Pn "\e]0;$1\a"
}

# Add a blank line after ps1
precmd() {
  print ""
  if [[ -n "$CUSTOM_TITLE" ]]; then
    print -Pn "\e]0;$CUSTOM_TITLE\a"
  fi
}

softReset() {
  if [ -z "$1" ]; then
    echo "❌ Usage: squash_and_rebase <branch>"
    return 1
  fi

  local target_branch=$1

  # make sure we have the latest refs
  git fetch origin

  # find the common ancestor between current branch and target
  local base
  base=$(git merge-base HEAD origin/$target_branch) || return 1

  # squash all commits into one (keeps changes staged)
  git reset --soft "$base" || return 1
}

#####################################################################################
# Git Worktree
#####################################################################################
work-tree() {
  local name=""
  local base_branch="dev"
  local prefix=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--base)
        base_branch="$2"
        shift 2
        ;;
      -p|--prefix)
        prefix="$2"
        shift 2
        ;;
      -h|--help)
        echo "Usage: work-tree <name> [-b <base-branch>] [-p <prefix>]"
        echo ""
        echo "Options:"
        echo "  -b, --base    Base branch (default: dev)"
        echo "  -p, --prefix  Branch prefix (e.g., feature, bugfix)"
        echo ""
        echo "Examples:"
        echo "  work-tree auth-service              # branch: auth-service"
        echo "  work-tree auth-service -p feature   # branch: feature/auth-service"
        echo "  work-tree hotfix -b main            # from main branch"
        return 0
        ;;
      -*)
        echo "Unknown option: $1"
        return 1
        ;;
      *)
        name="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "Error: Please provide a branch name"
    echo "Usage: work-tree <name> [-b <base-branch>] [-p <prefix>]"
    return 1
  fi

  local branch_name
  if [[ -n "$prefix" ]]; then
    branch_name="${prefix}/${name}"
  else
    branch_name="$name"
  fi

  local repo_name=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")")
  local worktree_dir="../${repo_name}-${name}"

  echo "Creating worktree for ${branch_name} from ${base_branch}..."
  git worktree add "${worktree_dir}" -b "${branch_name}" "${base_branch}"

  if [[ $? -eq 0 ]]; then
    echo "✅ Worktree created at ${worktree_dir}"
    echo "📂 Branch: ${branch_name}"
    cd "${worktree_dir}"
    ts "${name}"
  else
    echo "❌ Failed to create worktree"
    return 1
  fi
}
alias worktree='work-tree'

source ~/.raftrc
