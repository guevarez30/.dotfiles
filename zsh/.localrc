###################################################################################
# Functions
###################################################################################
killport() {
	kill -9 $(lsof -ti:$@)
}

count(){
	ls $@ -1 | wc -l
}

gitExclude() {
	echo $@ >> ~/.git/info/exclude
}

###################################################################################
# TMUX
###################################################################################
# Fuzzy attach to or create a tmux session
t() {
    if [ $# -gt 0 ]; then
        tmux new-session -A -s "$1"
    else
        sesh connect $(sesh list --tmux | fzf --height 40% --reverse --border --prompt '⚡ ' | tr -d '[:space:]')
    fi
}

###################################################################################
# Git
###################################################################################
push(){
   git push --set-upstream origin $1
}

remote_checkout(){
  fetch
  git checkout -b $1 origin/$1
}

#####################################################################################
#Aliases
#####################################################################################
alias vim='nvim'
alias v='nvim'
alias mv='mv -i'
alias vlear='clear'
alias cls='clear'
alias clera='clear'
alias celar='clear'
alias ckear='clear'
alias ckear='clear'
alias ipconfig='ifconfig'
alias dot='cd ~/.dotfiles'
alias grep='rg'
alias find='fd'
alias ls="eza"
alias ll="eza -l --git"
alias tree="eza --tree"
alias lt='du -sh * | sort -h'
alias loads='cd ~/raft-tech'
alias src='source ~/.zshrc'
alias diff='nvim -d'
alias dif='diff'
alias pretty="jq '.'"

#####################################################################################
