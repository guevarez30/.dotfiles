###################################################################################
# Functions
###################################################################################
killport() {
	kill -9 $(lsof -ti:$@)
}

count(){
	ls $@ -1 | wc -l
}

gitExclude() {
	echo $@ >> ~/.git/info/exclude
}

wtpr() {
  local remote_branch="$1"

  if [ -z "$remote_branch" ]; then
    echo "Usage: wtpr <remote-branch>"
    return 1
  fi

  git rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "Not inside a git repository"
    return 1
  }

  local repo_root repo_name worktree_root worktree_dir local_branch
  repo_root=$(git rev-parse --show-toplevel)
  repo_name=$(basename "$repo_root")
  worktree_root="$HOME/pr/$repo_name"
  worktree_dir="${worktree_root}/${remote_branch}"
  local_branch="pr-${remote_branch//\//-}"

  mkdir -p "$(dirname "$worktree_dir")"

  git fetch origin

  # If worktree already exists, remove it cleanly
  if git worktree list | grep -Fq -- "$worktree_dir"; then
    git worktree remove "$worktree_dir" --force
  fi

  # Recreate PR worktree on a local branch, leaving the original branch untouched
  git worktree add -B "$local_branch" "$worktree_dir" "origin/$remote_branch" || return 1

  cd "$worktree_dir"
}

###################################################################################
# TMUX
###################################################################################
# Fuzzy attach to or create a tmux session with Tab/Shift+Tab navigation
tn() {
    local name
    name=$(basename "$PWD" | tr '[:lower:]' '[:upper:]')
    tmux new-session -s "$name" $@
}

###################################################################################
# Git
###################################################################################
push(){
   git push --set-upstream origin $1
}

remote_checkout(){
  fetch
  git checkout -b $1 origin/$1
}

