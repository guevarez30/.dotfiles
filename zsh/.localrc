###################################################################################
# Functions
###################################################################################
killport() {
    local pid=$(ss -tlnp 2>/dev/null | command grep ":$1 " | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1)
    if [[ -n "$pid" ]]; then
        kill -9 $pid && echo "Killed process $pid on port $1"
    else
        echo "No process found on port $1"
    fi
}

count(){
	ls $@ -1 | wc -l
}

gitExclude() {
	echo $@ >> ~/.git/info/exclude
}

###################################################################################
# TMUX
###################################################################################
tn() {
    local name
    name=$(basename "$PWD" | tr '[:lower:]' '[:upper:]')
    tmux new-session -s "$name" $@
}

t() {
    if [ $# -gt 0 ]; then
        tmux new-session -A -s "$1"
    else
        sesh connect $(sesh list --tmux | fzf \
            --height 40% \
            --reverse \
            --border \
            --prompt '⚡ ' \
            --bind 'tab:down,shift-tab:up' \
            --bind 'ctrl-j:down,ctrl-k:up' \
            --pointer '▶' \
            --marker '✓' | tr -d '[:space:]')
    fi
}

